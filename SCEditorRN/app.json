{
  "expo": {
    "name": "SC Editor",
    "slug": "sc-editor-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0E0E14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E14"
      },
      "package": "com.sceditor.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/octet-stream"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-document-picker"
    ],
    "scheme": "sceditor",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "497330a3-e4b3-4f84-9cc5-eb3074f1bf75"
      }
    }
  }
}
